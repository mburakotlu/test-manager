# Copy this file to .env and fill in your own values. Never commit .env.
JIRA_BASE_URL=https://api.skyway.porsche.com
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-personal-access-token
JIRA_AUTH_MODE=bearer
JIRA_IS_TEC_NET=false
JIRA_VERIFY_SSL=false
WORKSPACE_ROOT=C:\Users\you\Desktop\Repos\jira_manager

# Used by future sprint/ticket-generation features (not required for basic connection).
JIRA_PROJECT_KEY=PHUB

# Confluence PAT - separate token from JIRA_API_TOKEN, required for Confluence API access on this instance.
CONFLUENCE_API_TOKEN=your-confluence-personal-access-token
